# Permish — Caddy reverse proxy configuration
#
# Automatic HTTPS via Let's Encrypt.
# Certs are auto-obtained on first request and renewed 30 days before expiry.
#
# Set DOMAIN env var to your domain (e.g., permish.app)

{$DOMAIN:localhost} {
	# Frontend — all non-API traffic
	reverse_proxy frontend:3000

	# API routes — proxy to the Permish server (Bun + Hono + SQLite)
	handle /api/* {
		reverse_proxy server:3001
	}

	# Compression
	encode gzip zstd

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Logging
	log {
		output stdout
		format console
	}
}

